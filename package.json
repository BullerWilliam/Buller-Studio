{
  "name": "buller-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop 3D game engine and project studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "fengari": "^0.1.4",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.buller.engine",
    "productName": "Buller Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "BullerStudio-${version}-${arch}.exe"
    }
  },
  "allowScripts": {
    "electron@36.9.5": true
  }
}
