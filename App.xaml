<Application x:Class="BullerStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup" ShutdownMode="OnLastWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#101522" />
    <SolidColorBrush x:Key="PanelBackground" Color="#171E2C" />
    <SolidColorBrush x:Key="PanelRaised" Color="#1C2535" />
    <SolidColorBrush x:Key="PanelBorder" Color="#293549" />
    <SolidColorBrush x:Key="TextPrimary" Color="#DCE3EF" />
    <SolidColorBrush x:Key="TextMuted" Color="#8492A8" />
    <SolidColorBrush x:Key="Accent" Color="#65A4FF" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Background" Value="#202B3B" />
      <Setter Property="BorderBrush" Value="#34435A" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Background" Value="#111824" />
      <Setter Property="BorderBrush" Value="#34435A" />
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Resources>
</Application>
