<Window x:Class="BullerStudio.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Buller Game" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="#101522" Foreground="#DCE3EF" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
  <Grid>
    <hx:Viewport3DX x:Name="GameViewport" BackgroundColor="#101522" MSAA="Maximum"
                    MouseDown3D="Viewport_MouseDown3D"
                    PreviewMouseRightButtonDown="Viewport_RightButtonDown"
                    PreviewMouseRightButtonUp="Viewport_RightButtonUp"
                    PreviewMouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave" PreviewMouseWheel="Viewport_MouseWheel"
                    Focusable="True" />
    <Canvas x:Name="GameGuiCanvas"/>
    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="10,7"
            Background="#BB111725" IsHitTestVisible="False">
      <TextBlock x:Name="GameTitle" FontSize="13" FontWeight="SemiBold" />
    </Border>
    <Border x:Name="PlayTestControls" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" Padding="6"
            Background="#DD111725" BorderBrush="#33446688" BorderThickness="1" CornerRadius="6">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="PauseButton" Content="Ⅱ  Pause" MinWidth="92" Padding="10,5" Click="PausePlayTest_Click" />
        <Button Content="■  Stop" MinWidth="82" Padding="10,5" Margin="6,0,0,0" Click="StopPlayTest_Click" />
      </StackPanel>
    </Border>
    <Border x:Name="VehicleHud" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" Padding="12,9"
            Background="#DD111725" BorderBrush="#6689B9FF" BorderThickness="1" CornerRadius="7"
            IsHitTestVisible="False" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="VEHICLE" FontSize="10" FontWeight="Bold" Foreground="#9EB1D2" />
        <TextBlock x:Name="VehicleHudText" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="10,7"
            Background="#BB111725" IsHitTestVisible="False">
      <TextBlock Text="WASD Move  ·  Space Jump  ·  Right drag Look  ·  Wheel Zoom" FontSize="12" />
    </Border>
    <Border x:Name="PromptBorder" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="12,12,12,62" Padding="14,10" Background="#E6111725"
            BorderBrush="#6689B9FF" BorderThickness="1" CornerRadius="7"
            IsHitTestVisible="False" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="35" Height="35" CornerRadius="5" Background="#344766" Margin="0,0,12,0">
          <TextBlock x:Name="PromptInputText" Text="E" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PromptObjectText" FontSize="11" Foreground="#9EB1D2" />
          <TextBlock x:Name="PromptActionText" FontSize="15" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
