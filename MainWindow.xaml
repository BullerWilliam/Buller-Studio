<Window x:Class="BullerStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:models="clr-namespace:BullerStudio.Models"
        Title="Buller Studio" Width="1540" Height="980" MinWidth="1120" MinHeight="700"
        Background="#1C1C1C" Foreground="#E7E7E7" KeyDown="Window_KeyDown">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type models:SceneNode}" ItemsSource="{Binding Children}">
      <DockPanel LastChildFill="True" Margin="2,1">
        <TextBlock Text="▰" Foreground="#8B9CAD" Margin="2,0,7,0"/>
        <TextBlock Text="{Binding Name}"/>
        <TextBlock Text="{Binding Type}" Foreground="#7F858D" Margin="8,0,0,0"/>
      </DockPanel>
    </HierarchicalDataTemplate>
    <Style x:Key="DockCaption" TargetType="Border">
      <Setter Property="Background" Value="#252628"/>
      <Setter Property="BorderBrush" Value="#101112"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style x:Key="RibbonGroup" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="7,4"/>
    </Style>
    <Style x:Key="RibbonTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="MinWidth" Value="62"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RibbonTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="13,4"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#D7D7D7"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="IsExpanded" Value="True"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="31"/>
      <RowDefinition Height="32"/>
      <RowDefinition Height="82"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="22"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#202123" BorderBrush="#111213" BorderThickness="0,0,0,1">
      <DockPanel Margin="7,0">
        <Border Width="19" Height="19" Background="#00A2FF" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="B" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Border>
        <TextBlock Text="Buller Studio" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="  |  " Foreground="#66686B" VerticalAlignment="Center" Margin="7,0"/>
        <TextBlock x:Name="ProjectTitle" Text="Untitled project" Foreground="#C5C7CA" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="⌂  Home" Click="ShowProjects_Click" Padding="10,3"/>
          <TextBlock x:Name="TitleProjectPath" Foreground="#92969B" VerticalAlignment="Center" FontSize="10" Margin="10,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="#252628" BorderBrush="#111213" BorderThickness="0,0,0,1">
      <DockPanel Margin="5,0">
        <Button Content="FILE" Click="ShowProjects_Click" Padding="13,3" Background="#252628" BorderBrush="Transparent" FontWeight="Bold"/>
        <StackPanel x:Name="RibbonTabBar" Orientation="Horizontal" Margin="5,0">
          <Button Content="HOME" Tag="HOME" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click"/>
          <Button Content="MODEL" Tag="MODEL" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click"/>
          <Button Content="TEST" Tag="TEST" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click"/>
          <Button Content="VIEW" Tag="VIEW" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click"/>
          <Button Content="SCRIPT" Tag="SCRIPT" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click"/>
          <Button Content="PLUGINS" Tag="PLUGINS" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="▶  Play" Click="Play_Click" Background="#287A3D" Padding="13,4"/>
          <Button Content="Ⅱ" Padding="9,4"/>
          <Button Content="■" Padding="9,4"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Background="#2B2C2F" BorderBrush="#111213" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RibbonTools" Orientation="Horizontal" VerticalAlignment="Stretch">
          <StackPanel x:Name="ClipboardGroup" Tag="HOME,SCRIPT" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Content="Save\nCtrl+S" Style="{StaticResource RibbonTool}" Click="Save_Click"/>
              <Button Content="Undo" Style="{StaticResource RibbonTool}" Click="Undo_Click"/>
              <Button Content="Redo" Style="{StaticResource RibbonTool}" Click="Redo_Click"/>
            </StackPanel><TextBlock Text="Clipboard &amp; History" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="TransformGroup" Tag="HOME,MODEL" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Content="Select" Style="{StaticResource RibbonTool}"/>
              <Button Content="Move" Style="{StaticResource RibbonTool}"/>
              <Button Content="Scale" Style="{StaticResource RibbonTool}"/>
              <Button Content="Rotate" Style="{StaticResource RibbonTool}"/>
            </StackPanel><TextBlock Text="Tools" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="InsertGroup" Tag="HOME,MODEL" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Content="Part ▾" Style="{StaticResource RibbonTool}" Click="AddPart_Click"/>
              <Button Content="Mesh" Style="{StaticResource RibbonTool}" Click="AddMesh_Click"/>
              <Button Content="Image" Style="{StaticResource RibbonTool}" Click="AddImage_Click"/>
              <Button Content="Folder" Style="{StaticResource RibbonTool}" Click="AddFolder_Click"/>
              <Button Content="Script" Style="{StaticResource RibbonTool}" Click="AddScript_Click"/>
            </StackPanel><TextBlock Text="Insert" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="WindowsGroup" Tag="VIEW" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Content="Import\nAssets" Style="{StaticResource RibbonTool}" Click="ImportAssets_Click"/>
              <Button Content="Explorer" Style="{StaticResource RibbonTool}"/>
              <Button Content="Properties" Style="{StaticResource RibbonTool}"/>
              <Button Content="Output" Style="{StaticResource RibbonTool}" Click="OutputTab_Click"/>
            </StackPanel><TextBlock Text="Windows" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="PublishGroup" Tag="HOME" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="IncludedButton" Content="Included" Style="{StaticResource RibbonTool}" Click="Included_Click"/>
              <Button x:Name="ExcludedButton" Content="Excluded" Style="{StaticResource RibbonTool}" Click="Excluded_Click"/>
              <Button Content="Build\n.exe" Style="{StaticResource RibbonTool}" Background="#1877C9" Click="Build_Click"/>
            </StackPanel><TextBlock Text="Publish" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="ModelGroup" Tag="MODEL" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal"><Button Content="Anchor" Style="{StaticResource RibbonTool}" Click="AnchorSelection_Click"/><Button Content="Focus" Style="{StaticResource RibbonTool}" Click="FocusSelection_Click"/></StackPanel>
            <TextBlock Text="Selection" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="TestGroup" Tag="TEST" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal"><Button Content="▶ Run" Style="{StaticResource RibbonTool}" Click="Play_Click"/><Button Content="Stop" Style="{StaticResource RibbonTool}" Click="StopPlayer_Click"/></StackPanel>
            <TextBlock Text="Playtest" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="ViewGroup" Tag="VIEW" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal"><Button Content="Shadows" Style="{StaticResource RibbonTool}" Click="ToggleShadows_Click"/><Button Content="Workspace Camera" Style="{StaticResource RibbonTool}" Click="ResetCamera_Click"/></StackPanel>
            <TextBlock Text="Viewport" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="ScriptGroup" Tag="SCRIPT" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal"><Button Content="＋ Script" Style="{StaticResource RibbonTool}" Click="AddScript_Click"/><Button Content="Run Script" Style="{StaticResource RibbonTool}" Click="RunSelectedScript_Click"/><Button Content="Output" Style="{StaticResource RibbonTool}" Click="OutputTab_Click"/></StackPanel>
            <TextBlock Text="Lua X" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="PluginsGroup" Tag="PLUGINS" Style="{StaticResource RibbonGroup}">
            <TextBlock Text="No plugins installed" Foreground="#A0A3A7" VerticalAlignment="Center" Margin="12"/>
            <TextBlock Text="Plugins" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid x:Name="WorkspaceGrid" Grid.Row="3" Background="#191A1B" Margin="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="164"/></Grid.RowDefinitions>

      <Border x:Name="ToolboxPanel" Grid.Column="0" Grid.RowSpan="2" Background="#252628" BorderBrush="#111213" BorderThickness="0,0,1,0" Tag="DockPanel">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource DockCaption}"><DockPanel><TextBlock Text="TOOLBOX" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/><Button Content="⋯" DockPanel.Dock="Right" Padding="4,0"/></DockPanel></Border>
          <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Project assets" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Import local images and OBJ meshes to use them in your scene or scripts." TextWrapping="Wrap" Foreground="#9DA0A4" FontSize="11" Margin="0,0,0,10"/>
            <Button Content="＋  Import Assets" Click="ImportAssets_Click" HorizontalContentAlignment="Center"/>
            <ListBox x:Name="ToolboxAssetList" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="#D7D7D7"/>
          </StackPanel>
          <Button Grid.Row="2" Content="＋ Import files" Click="ImportAssets_Click" Margin="7,3"/>
        </Grid>
      </Border>

      <Border x:Name="ScenePanel" Grid.Column="1" Grid.Row="0" Background="#101214" BorderBrush="#111213" BorderThickness="0,0,0,1">
        <Grid>
          <hx:Viewport3DX x:Name="SceneViewport" BackgroundColor="#101522" IsShadowMappingEnabled="True" MSAA="Maximum" MouseDown3D="SceneViewport_MouseDown3D" PreviewMouseRightButtonDown="SceneViewport_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="SceneViewport_PreviewMouseRightButtonUp" PreviewMouseMove="SceneViewport_PreviewMouseMove" PreviewMouseWheel="SceneViewport_PreviewMouseWheel" Focusable="True"/>
          <Border VerticalAlignment="Top" Background="#EE252628" Padding="8,5" MouseLeftButtonDown="DockHeader_MouseLeftButtonDown" MouseMove="DockHeader_MouseMove" MouseLeftButtonUp="DockHeader_MouseLeftButtonUp">
            <DockPanel><TextBlock Text="◉  Viewport" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Workspace Camera  ·  WASD move  ·  RMB look" DockPanel.Dock="Right" Foreground="#A0A3A7" FontSize="10"/></DockPanel>
          </Border>
          <TextBlock Text="Camera view uses the Workspace Camera" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#81858A" FontSize="10" IsHitTestVisible="False"/>
        </Grid>
      </Border>

      <Border x:Name="RightDock" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#252628" Tag="DockPanel">
       <Grid><Grid.RowDefinitions><RowDefinition Height="1.12*"/><RowDefinition Height="0.88*"/></Grid.RowDefinitions>
        <Border x:Name="ExplorerPanel" Grid.Row="0" Background="#252628" BorderBrush="#101112" BorderThickness="0,0,0,1">
          <Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource DockCaption}" MouseLeftButtonDown="DockHeader_MouseLeftButtonDown" MouseMove="DockHeader_MouseMove" MouseLeftButtonUp="DockHeader_MouseLeftButtonUp"><DockPanel><TextBlock Text="EXPLORER" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ObjectCount" DockPanel.Dock="Right" Foreground="#9DA0A4" VerticalAlignment="Center" FontSize="10"/></DockPanel></Border>
            <TreeView x:Name="ExplorerTree" Grid.Row="1" Margin="5" Background="Transparent" BorderThickness="0" Foreground="#D7D7D7" SelectedItemChanged="ExplorerTree_SelectedItemChanged"/>
          </Grid>
        </Border>
        <Border x:Name="PropertiesPanel" Grid.Row="1" Background="#252628" BorderBrush="#101112" BorderThickness="0,1,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource DockCaption}" MouseLeftButtonDown="DockHeader_MouseLeftButtonDown" MouseMove="DockHeader_MouseMove" MouseLeftButtonUp="DockHeader_MouseLeftButtonUp"><DockPanel><TextBlock Text="PROPERTIES" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/></DockPanel></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PropertyEditor" Margin="10"/></ScrollViewer>
          </Grid>
        </Border>
       </Grid>
      </Border>

      <Border x:Name="BottomPanel" Grid.Column="1" Grid.Row="1" Background="#252628" BorderBrush="#111213" BorderThickness="0,1,0,0" Tag="DockPanel">
        <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Background="#252628" MouseLeftButtonDown="DockHeader_MouseLeftButtonDown" MouseMove="DockHeader_MouseMove" MouseLeftButtonUp="DockHeader_MouseLeftButtonUp">
            <StackPanel Orientation="Horizontal"><Button x:Name="OutputTab" Content="Output" Click="OutputTab_Click" Padding="12,3"/><Button x:Name="AssetsTab" Content="Asset Manager" Click="AssetsTab_Click" Padding="12,3"/><Button x:Name="LuaTab" Content="Lua X" Click="LuaTab_Click" Padding="12,3"/></StackPanel>
            <Button DockPanel.Dock="Right" Content="⌄" Padding="7,1"/>
          </DockPanel>
          <ContentControl x:Name="BottomContent" Grid.Row="1"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="4" Background="#202123" BorderBrush="#111213" BorderThickness="0,1,0,0">
      <DockPanel Margin="7,0"><TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="#A0A3A7" VerticalAlignment="Center"/><TextBlock Text="Lua X  |  Local project" DockPanel.Dock="Right" FontSize="10" Foreground="#85898D" VerticalAlignment="Center"/></DockPanel>
    </Border>
  </Grid>
</Window>
