<Window x:Class="BullerStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:models="clr-namespace:BullerStudio.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Buller Studio" Icon="{StaticResource BullerStudioIcon}" Width="1540" Height="980" MinWidth="980" MinHeight="620" WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="#1F2022" Foreground="#F2F3F4" KeyDown="Window_KeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <HierarchicalDataTemplate DataType="{x:Type models:SceneNode}" ItemsSource="{Binding Children}">
      <DockPanel LastChildFill="True" Margin="2,1">
        <Button DockPanel.Dock="Right" Content="+" Tag="{Binding}" Width="20" Height="18" Padding="0" Margin="2,0,0,0" FontSize="12" Click="ExplorerAddObject_Click" ToolTip="Insert an object under this node"/>
        <TextBlock x:Name="NodeIcon" Text="▰" Foreground="#8B9CAD" Margin="2,0,7,0"/>
        <TextBlock Text="{Binding Name}"/>
      </DockPanel>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding Type}" Value="Workspace"><Setter TargetName="NodeIcon" Property="Text" Value="◈"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#8AB8E8"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Lighting"><Setter TargetName="NodeIcon" Property="Text" Value="☀"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#F2D587"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Sky"><Setter TargetName="NodeIcon" Property="Text" Value="☁"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#8AB8E8"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Players"><Setter TargetName="NodeIcon" Property="Text" Value="♟"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#8AB8E8"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ReplicatedStorage"><Setter TargetName="NodeIcon" Property="Text" Value="▤"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#8AB8E8"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ServerScriptService"><Setter TargetName="NodeIcon" Property="Text" Value="{}"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#B5A1DA"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ServerStorage"><Setter TargetName="NodeIcon" Property="Text" Value="▥"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D4BD75"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Camera"><Setter TargetName="NodeIcon" Property="Text" Value="◉"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#9ACD86"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Part"><Setter TargetName="NodeIcon" Property="Text" Value="▰"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#91B9DF"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="MeshPart"><Setter TargetName="NodeIcon" Property="Text" Value="◇"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#A89BE4"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="WedgePart"><Setter TargetName="NodeIcon" Property="Text" Value="◢"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#91B9DF"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="CornerWedgePart"><Setter TargetName="NodeIcon" Property="Text" Value="◣"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#91B9DF"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="SpawnLocation"><Setter TargetName="NodeIcon" Property="Text" Value="✚"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#7ED9B7"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="TrussPart"><Setter TargetName="NodeIcon" Property="Text" Value="▤"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#C6B28F"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Seat"><Setter TargetName="NodeIcon" Property="Text" Value="▣"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#C6B28F"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Model"><Setter TargetName="NodeIcon" Property="Text" Value="▣"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#78D49C"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="PointLight"><Setter TargetName="NodeIcon" Property="Text" Value="☀"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#F2D587"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="SpotLight"><Setter TargetName="NodeIcon" Property="Text" Value="◉"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#F2D587"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="SurfaceLight"><Setter TargetName="NodeIcon" Property="Text" Value="◐"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#F2D587"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Decal"><Setter TargetName="NodeIcon" Property="Text" Value="▧"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#E4C699"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ProximityPrompt"><Setter TargetName="NodeIcon" Property="Text" Value="Ⓔ"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#9DD5EC"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ClickDetector"><Setter TargetName="NodeIcon" Property="Text" Value="◎"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#9DD5EC"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Highlight"><Setter TargetName="NodeIcon" Property="Text" Value="✦"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#FFE4A0"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="WeldConstraint"><Setter TargetName="NodeIcon" Property="Text" Value="⊟"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#C9B9F3"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Attachment"><Setter TargetName="NodeIcon" Property="Text" Value="⊕"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#C9B9F3"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Beam"><Setter TargetName="NodeIcon" Property="Text" Value="〰"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#C9B9F3"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Humanoid"><Setter TargetName="NodeIcon" Property="Text" Value="♙"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#7ED9B7"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Vector3Value"><Setter TargetName="NodeIcon" Property="Text" Value="XYZ"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#E2BE86"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Color3Value"><Setter TargetName="NodeIcon" Property="Text" Value="◈"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#E2BE86"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ObjectValue"><Setter TargetName="NodeIcon" Property="Text" Value="↗"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#E2BE86"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ImageLabel"><Setter TargetName="NodeIcon" Property="Text" Value="▧"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D9B67A"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="UIGradient"><Setter TargetName="NodeIcon" Property="Text" Value="◩"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D9B67A"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="UIPadding"><Setter TargetName="NodeIcon" Property="Text" Value="▣"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D9B67A"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="UIScale"><Setter TargetName="NodeIcon" Property="Text" Value="↗"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D9B67A"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="UIGridLayout"><Setter TargetName="NodeIcon" Property="Text" Value="▦"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D9B67A"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Folder"><Setter TargetName="NodeIcon" Property="Text" Value="▱"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D4BD75"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Configuration"><Setter TargetName="NodeIcon" Property="Text" Value="⚙"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#D4BD75"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="BindableEvent"><Setter TargetName="NodeIcon" Property="Text" Value="⚡"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#E7CA86"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="BindableFunction"><Setter TargetName="NodeIcon" Property="Text" Value="⇄"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#E7CA86"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="Script"><Setter TargetName="NodeIcon" Property="Text" Value="{}"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#B5A1DA"/></DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="ModuleScript"><Setter TargetName="NodeIcon" Property="Text" Value="⬡"/><Setter TargetName="NodeIcon" Property="Foreground" Value="#B5A1DA"/></DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
    <Style x:Key="DockCaption" TargetType="Border">
      <Setter Property="Background" Value="#252628"/>
      <Setter Property="BorderBrush" Value="#101112"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style x:Key="PropertySectionExpander" TargetType="Expander">
      <Setter Property="Foreground" Value="#D7D7D7"/>
      <Setter Property="Background" Value="#303235"/>
      <Setter Property="IsExpanded" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="SectionHeader" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="#383A3D" BorderThickness="0,0,0,1" Padding="7,5" HorizontalContentAlignment="Stretch">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#393B3E"/></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#414347"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <DockPanel LastChildFill="True"><TextBlock x:Name="SectionArrow" Text="▸" Foreground="#A0A3A7" Margin="0,0,7,0"/><ContentPresenter ContentSource="Header"/></DockPanel>
              </ToggleButton>
              <ContentPresenter x:Name="SectionContent" Visibility="Collapsed" ContentSource="Content" Margin="7,2,7,5"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SectionContent" Property="Visibility" Value="Visible"/><Setter TargetName="SectionArrow" Property="Text" Value="▾"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RibbonGroup" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Margin" Value="4,4"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="RibbonTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="2,4"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RibbonTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#303235"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#383B3E"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#D7D7D7"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="IsExpanded" Value="True"/>
      <Setter Property="Visibility" Value="{Binding IsExplorerVisible, Converter={StaticResource BooleanToVisibility}}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ToggleButton x:Name="ExpanderButton" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="▸" Foreground="#A0A3A7" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Focusable="False" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Border x:Name="HeaderChrome" Grid.Column="1" Background="Transparent" Padding="3,0">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False"><Setter TargetName="ExpanderButton" Property="Visibility" Value="Hidden"/></Trigger>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/><Setter TargetName="ExpanderButton" Property="Content" Value="▾"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#303337"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#294258"/></Trigger>
              <DataTrigger Binding="{Binding IsExplorerSelected}" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#294258"/></DataTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#202123"/>
      <Setter Property="BorderBrush" Value="#111213"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#C7C9CC"/>
      <Setter Property="Background" Value="#202123"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#303235"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="#2388D1"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#2B2D30"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="30"/>
      <RowDefinition Height="76"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="22"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#222426" BorderBrush="#111213" BorderThickness="0,0,0,1">
      <Grid Margin="5,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="FILE" Click="FileMenu_Click" Padding="13,3" Background="#252628" BorderBrush="Transparent" FontWeight="Bold" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Content="VIEW" Click="WindowMenu_Click" Padding="10,3" Background="#222426" BorderBrush="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Click="ShowProjects_Click" Padding="8,3" Background="#222426" BorderBrush="Transparent" ToolTip="Home / projects" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Border Width="1" Height="19" Background="#414346" Margin="4,0" VerticalAlignment="Center"/>
          <Button Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" Click="Save_Click" Padding="7,3" Background="Transparent" BorderBrush="Transparent" ToolTip="Save project (Ctrl+S)" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Click="Undo_Click" Padding="7,3" Background="Transparent" BorderBrush="Transparent" ToolTip="Undo (Ctrl+Z)" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" Click="Redo_Click" Padding="7,3" Background="Transparent" BorderBrush="Transparent" ToolTip="Redo (Ctrl+Shift+Z)" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Border Width="1" Height="19" Background="#414346" Margin="4,0" VerticalAlignment="Center"/>
          <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Click="Play_Click" Background="#287A3D" Padding="9,3" ToolTip="Play test" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Click="StopPlayer_Click" Padding="9,3" ToolTip="Stop test" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#D7D9DC" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" IsHitTestVisible="False"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow_Click" ToolTip="Minimize"/>
          <Button x:Name="MaximizeWindowButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeWindow_Click" ToolTip="Maximize"/>
          <Button Style="{StaticResource TitleBarButton}" Tag="Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click" ToolTip="Close"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#222426" BorderBrush="#111213" BorderThickness="0,0,0,1">
      <StackPanel x:Name="RibbonTabBar" Orientation="Horizontal" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="Home" Tag="HOME" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Content="Model" Tag="MODEL" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Content="Camera" Tag="CAMERA" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Content="Script" Tag="SCRIPT" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Content="Plugins" Tag="PLUGINS" Style="{StaticResource RibbonTab}" Click="RibbonTab_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#292B2D" BorderBrush="#111213" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RibbonTools" Orientation="Horizontal" VerticalAlignment="Stretch">
          <StackPanel x:Name="TransformGroup" Tag="HOME,MODEL" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SelectToolButton" Style="{StaticResource RibbonTool}" Click="ToolSelect_Click"><StackPanel><TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Select" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="MoveToolButton" Style="{StaticResource RibbonTool}" Click="ToolMove_Click"><StackPanel><TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Move" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="ScaleToolButton" Style="{StaticResource RibbonTool}" Click="ToolScale_Click"><StackPanel><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Scale" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="RotateToolButton" Style="{StaticResource RibbonTool}" Click="ToolRotate_Click"><StackPanel><TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Rotate" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
            </StackPanel><TextBlock Text="Tools" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Height="54" Background="#44474A" Margin="3,8" VerticalAlignment="Center" Tag="HOME,MODEL"/>
          <StackPanel x:Name="WindowsGroup" Tag="HOME" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource RibbonTool}" Click="Explorer_Click" ToolTip="Show Explorer"><StackPanel><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Explorer" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Style="{StaticResource RibbonTool}" Click="Properties_Click" ToolTip="Show Properties"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Properties" FontSize="8" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Style="{StaticResource RibbonTool}" Click="OutputTab_Click"><StackPanel><TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Output" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Button>
              <Button Style="{StaticResource RibbonTool}" Click="AssetsTab_Click"><StackPanel><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Assets" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
            </StackPanel><TextBlock Text="Windows" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Height="54" Background="#44474A" Margin="3,8" VerticalAlignment="Center" Tag="HOME"/>
          <StackPanel x:Name="BuildGroup" Tag="HOME" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center" Margin="2,0">
                <Button x:Name="IncludedButton" Content="Included" Click="Included_Click" Width="76" Height="25" Padding="7,2" HorizontalContentAlignment="Left" Background="{StaticResource Accent}" ToolTip="Include assets inside the executable"/>
                <Button x:Name="ExcludedButton" Content="Excluded" Click="Excluded_Click" Width="76" Height="25" Padding="7,2" HorizontalContentAlignment="Left" Background="{StaticResource PanelRaised}" ToolTip="Place assets beside the executable"/>
              </StackPanel>
              <Button Style="{StaticResource RibbonTool}" Width="52" MinWidth="52" Click="Build_Click" ToolTip="Compile this project">
                <StackPanel><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Build" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="Build" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Height="54" Background="#44474A" Margin="3,8" VerticalAlignment="Center" Tag="MODEL"/>
          <StackPanel x:Name="ModelGroup" Tag="MODEL" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Content="Insert" Style="{StaticResource RibbonTool}" Click="InsertModel_Click" ToolTip="Insert a 3D object"/>
              <Button Content="Duplicate" Style="{StaticResource RibbonTool}" Width="70" MinWidth="70" Click="DuplicateSelected_Click" ToolTip="Duplicate selection (Ctrl+D)"/>
              <Button Content="Group" Style="{StaticResource RibbonTool}" Click="GroupSelected_Click" ToolTip="Wrap selection in a Model (Ctrl+G)"/>
              <Button Content="Ungroup" Style="{StaticResource RibbonTool}" Width="70" MinWidth="70" Click="UngroupSelected_Click" ToolTip="Move a Model's children to its parent (Ctrl+Shift+G)"/>
              <Button Content="Anchor" Style="{StaticResource RibbonTool}" Click="AnchorSelection_Click"/>
            </StackPanel>
            <TextBlock Text="Objects" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="CameraGroup" Tag="CAMERA" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource RibbonTool}" Click="CameraCustom_Click" ToolTip="Use the camera's position and rotation">
                <StackPanel><TextBlock Text="◉" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Custom" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Style="{StaticResource RibbonTool}" Click="FocusSelection_Click" ToolTip="Orbit the selected BasePart as the camera subject">
                <StackPanel><TextBlock Text="◎" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Subject" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Style="{StaticResource RibbonTool}" Click="ResetCamera_Click" ToolTip="Reset camera position and rotation">
                <StackPanel><TextBlock Text="↺" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Reset" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="Camera" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="ScriptGroup" Tag="SCRIPT" Style="{StaticResource RibbonGroup}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource RibbonTool}" Click="RunSelectedScript_Click" ToolTip="Run the selected Lua X script"><StackPanel><TextBlock Text="▶" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Run" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
            <TextBlock Text="Lua X" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="PluginsGroup" Tag="PLUGINS" Style="{StaticResource RibbonGroup}">
            <TextBlock Text="No plugins installed" Foreground="#A0A3A7" VerticalAlignment="Center" Margin="12"/>
            <TextBlock Text="Plugins" FontSize="9" Foreground="#9DA0A4" HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ad:DockingManager x:Name="DockManager" Grid.Row="3" Background="#191A1B" BorderThickness="0">
      <ad:DockingManager.Layout>
        <ad:LayoutRoot>
          <ad:LayoutPanel Orientation="Horizontal">
            <ad:LayoutPanel Orientation="Vertical">
              <ad:LayoutDocumentPaneGroup>
                <ad:LayoutDocumentPane>
                  <ad:LayoutDocument x:Name="ViewportDocument" Title="Project" ContentId="Viewport" CanClose="False">
                    <Border x:Name="ScenePanel" Background="#101214" BorderBrush="#111213" BorderThickness="0,0,0,1">
            <Grid>
              <hx:Viewport3DX x:Name="SceneViewport" BackgroundColor="#101522" IsShadowMappingEnabled="True" MSAA="Maximum" ShowCoordinateSystem="True" ShowViewCube="True" MouseDown3D="SceneViewport_MouseDown3D" PreviewMouseLeftButtonDown="SceneViewport_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SceneViewport_PreviewMouseLeftButtonUp" PreviewMouseRightButtonDown="SceneViewport_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="SceneViewport_PreviewMouseRightButtonUp" PreviewMouseMove="SceneViewport_PreviewMouseMove" PreviewMouseWheel="SceneViewport_PreviewMouseWheel" Focusable="True"/>
              <Canvas x:Name="GuiPreviewCanvas" Focusable="True" PreviewMouseLeftButtonDown="GuiPreviewCanvas_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="GuiPreviewCanvas_PreviewMouseLeftButtonUp" PreviewMouseMove="GuiPreviewCanvas_PreviewMouseMove"/>
              <Border VerticalAlignment="Top" Background="#EE252628" Padding="8,5">
                <DockPanel LastChildFill="False">
                  <TextBlock Text="◉  Workspace" FontSize="11" FontWeight="SemiBold"/>
                  <Button Content="⋯" Width="28" Height="22" Padding="0" Margin="2,0,0,0" Click="ViewportOptions_Click" DockPanel.Dock="Right" ToolTip="Viewport options"/>
                  <TextBlock Text="Workspace Camera  ·  WASD move  ·  RMB look" DockPanel.Dock="Right" Foreground="#A0A3A7" FontSize="10" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <TextBlock Text="Camera view uses the Workspace Camera" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#81858A" FontSize="10" IsHitTestVisible="False"/>
            </Grid>
                  </Border>
                  </ad:LayoutDocument>
                </ad:LayoutDocumentPane>
              </ad:LayoutDocumentPaneGroup>
              <ad:LayoutAnchorablePane DockHeight="164">
                <ad:LayoutAnchorable x:Name="OutputDock" Title="Output" ContentId="Output" CanClose="False" CanHide="True">
                  <Border x:Name="BottomPanel" Background="#252628" BorderBrush="#111213" BorderThickness="0,1,0,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <DockPanel Grid.Row="0" Background="#252628" LastChildFill="False">
                        <StackPanel Orientation="Horizontal"><Button x:Name="OutputTab" Content="Output" Click="OutputTab_Click" Padding="12,3"/><Button x:Name="AssetsTab" Content="Asset Manager" Click="AssetsTab_Click" Padding="12,3"/></StackPanel>
                      </DockPanel>
                      <ContentControl x:Name="BottomContent" Grid.Row="1"/>
                    </Grid>
                  </Border>
                </ad:LayoutAnchorable>
              </ad:LayoutAnchorablePane>
            </ad:LayoutPanel>
            <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="310">
              <ad:LayoutAnchorablePane DockHeight="1.12*">
                <ad:LayoutAnchorable x:Name="ExplorerDock" Title="Explorer" ContentId="Explorer" CanClose="False" CanHide="True">
                  <Border x:Name="ExplorerPanel" Background="#252628" BorderBrush="#101112" BorderThickness="0,0,0,1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="6,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                          <TextBox x:Name="ExplorerSearch" Padding="6,3" ToolTip="Filter by object name or type" TextChanged="ExplorerSearch_TextChanged"/>
                          <TextBlock x:Name="ExplorerSearchHint" Text="⌕  Filter objects" Foreground="#85898D" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="ObjectCount" Grid.Column="1" Margin="7,0,0,0" Foreground="#9DA0A4" FontSize="10" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                      <TreeView x:Name="ExplorerTree" Grid.Row="1" Margin="5" Background="Transparent" BorderThickness="0" Foreground="#D7D7D7" AllowDrop="True" SelectedItemChanged="ExplorerTree_SelectedItemChanged" PreviewMouseLeftButtonDown="ExplorerTree_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ExplorerTree_PreviewMouseLeftButtonUp" PreviewMouseRightButtonUp="ExplorerTree_PreviewMouseRightButtonUp" PreviewMouseMove="ExplorerTree_PreviewMouseMove" DragOver="ExplorerTree_DragOver" DragLeave="ExplorerTree_DragLeave" Drop="ExplorerTree_Drop" MouseDoubleClick="ExplorerTree_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                          <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="Visibility" Value="{Binding IsExplorerVisible, Converter={StaticResource BooleanToVisibility}}"/>
                          </Style>
                        </TreeView.ItemContainerStyle>
                      </TreeView>
                    </Grid>
                  </Border>
                </ad:LayoutAnchorable>
              </ad:LayoutAnchorablePane>
              <ad:LayoutAnchorablePane DockHeight="0.88*">
                <ad:LayoutAnchorable x:Name="PropertiesDock" Title="Properties" ContentId="Properties" CanClose="False" CanHide="True">
                  <Border x:Name="PropertiesPanel" Background="#252628" BorderBrush="#101112" BorderThickness="0,1,0,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="6,3">
              <TextBox x:Name="PropertySearch" Padding="6,3" ToolTip="Filter object properties" TextChanged="PropertySearch_TextChanged"/>
              <TextBlock x:Name="PropertySearchHint" Text="⌕  Filter properties" Foreground="#85898D" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PropertyEditor" Margin="10"/></ScrollViewer>
                    </Grid>
                  </Border>
                </ad:LayoutAnchorable>
              </ad:LayoutAnchorablePane>
            </ad:LayoutAnchorablePaneGroup>
          </ad:LayoutPanel>
        </ad:LayoutRoot>
      </ad:DockingManager.Layout>
    </ad:DockingManager>

    <Border Grid.Row="4" Background="#202123" BorderBrush="#111213" BorderThickness="0,1,0,0">
      <DockPanel Margin="7,0" LastChildFill="False"><TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="#A0A3A7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="Lua X  |  Local project" DockPanel.Dock="Right" FontSize="10" Foreground="#85898D" VerticalAlignment="Center"/></DockPanel>
    </Border>
  </Grid>
</Window>
